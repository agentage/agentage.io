{
  "name": "@agentage/extension-root",
  "version": "0.1.1",
  "description": "agentage.io: the site, the subscribers and the discovery documents, as the root extension",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/agentage.io.git"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/agentage.io/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "agentage": "^0.10 || ^0.11"
  },
  "agentage": {
    "id": "root",
    "parts": {
      "pages": true,
      "api": true,
      "store": "postgres"
    },
    "settings": {
      "platform": {
        "type": "string",
        "default": "https://platform.agentage.io",
        "description": "The account API origin, the platform field of agentage.json"
      },
      "market": {
        "type": "string",
        "default": "https://market.agentage.io",
        "description": "The market origin, markets[0] of agentage.json"
      },
      "cloud": {
        "type": "string",
        "default": "https://cloud.agentage.io",
        "description": "The cloud host origin, the cloud field of agentage.json"
      },
      "mcpRegistryAuth": {
        "type": "string",
        "default": "",
        "description": "The MCP registry domain proof served at /.well-known/mcp-registry-auth; empty answers 404"
      },
      "mailFrom": {
        "type": "string",
        "default": "AgentAge Memory <no-reply@mail.agentage.io>",
        "description": "The From of the subscriber welcome mail"
      },
      "telemetry": {
        "type": "string",
        "default": "https://logs.agentage.io",
        "description": "The telemetry origin of agentage.json when the platform names none"
      }
    },
    "secrets": [
      "resend",
      "unsubscribe"
    ]
  },
  "exports": {
    "./agentage-extension.json": "./dist/agentage-extension.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.test.*",
    "!dist/pages/site"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/api/welcome-mail.html src/api/welcome-mail.txt dist/api/ && node scripts/export-site.mjs",
    "type-check": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run build && npm run test:coverage",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@agentage/extension": "^0.10.0",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@agentage/cli": "0.50.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "keywords": [
    "agentage",
    "agentage-extension"
  ]
}
